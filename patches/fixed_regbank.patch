   char *freereg = NULL;
   bool fReentrant = (IFFUNC_ISREENT (sym->type) || options.stackAuto);
 
+  /* --fixed-regbank asserts the program stays on register bank 0; warn if a
+     function selects a non-default bank via __using, which is incompatible */
+  if (options.fixedRegbank && FUNC_REGBANK (ftype))
+    werror (W_FIXED_REGBANK_USING, sym->name);
+
   /* create the function header */
   emitcode (";", "-----------------------------------------");
   emitcode (";", " function %s", sym->name);
@@ -4512,7 +4512,8 @@
       if (!switchedPSW)
         {
           emitpush ("psw");
-          emitcode ("mov", "psw,#!constbyte", (FUNC_REGBANK (ftype) << 3) & 0x00ffu);
+          if (!options.fixedRegbank || FUNC_REGBANK (ftype))
+            emitcode ("mov", "psw,#!constbyte", (FUNC_REGBANK (ftype) << 3) & 0x00ffu);
         }
     }
   else
