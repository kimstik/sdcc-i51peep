+/*-----------------------------------------------------------------*/
+/* parseSymAddr - parse an SDCC symbolic address operand into a    */
+/* (symbol, byte offset) pair. Accepted forms:                     */
+/*   "(_sym + 0xNN)", "(_sym - NN)", "_sym", "0xNN", "NN"          */
+/* For a purely numeric operand sym is set to the empty string.    */
+/* Returns true on success, false on parse failure.                */
+/*-----------------------------------------------------------------*/
+static bool
+parseSymAddr (const char *addr, char *sym, size_t symSz, int *off)
+{
+  const char *p = addr;
+  const char *symStart;
+  size_t len;
+
+  *sym = '\0';
+  *off = 0;
+
+  /* skip leading whitespace and an optional opening parenthesis */
+  while (*p == ' ' || *p == '\t')
+    p++;
+  bool hasParen = (*p == '(');
+  if (hasParen)
+    p++;
+  while (*p == ' ' || *p == '\t')
+    p++;
+
+  /* purely numeric operand: 0xNN or decimal */
+  if ((p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) || ISCHARDIGIT (p[0]))
+    {
+      char *end;
+      long v = strtol (p, &end, 0);
+      while (*end == ' ' || *end == '\t')
+        end++;
+      if (hasParen && *end == ')')
+        end++;
+      if (*end == '\0' || *end == ' ' || *end == '\t' || *end == ';')
+        {
+          *off = (int) v;
+          return true;
+        }
+      /* not a clean numeric - fall through to symbol parsing */
+    }
+
+  /* symbol name, optionally followed by " + 0xNN" or " - NN" */
+  symStart = p;
+  while (*p && *p != ' ' && *p != '\t' && *p != '+' && *p != '-' && *p != ')')
+    p++;
+  len = p - symStart;
+  if (len == 0 || len >= symSz)
+    return false;
+  memcpy (sym, symStart, len);
+  sym[len] = '\0';
+
+  /* optional offset: sign and number may be separated by whitespace */
+  while (*p == ' ' || *p == '\t')
+    p++;
+  if (*p == '+' || *p == '-')
+    {
+      int sign = (*p == '-') ? -1 : 1;
+      char *end;
+      long v;
+
+      p++;
+      while (*p == ' ' || *p == '\t')
+        p++;
+      v = strtol (p, &end, 0);
+      *off = (int) (sign * v);
+      p = end;
+    }
+  while (*p == ' ' || *p == '\t')
+    p++;
+  if (hasParen && *p == ')')
+    p++;
+
+  return true;
+}
+
+/*-----------------------------------------------------------------*/
+/* operandOffset - check that two symbolic operands refer to the   */
+/* same symbol with addresses differing by a fixed byte offset.    */
+/* Usage: operandOffset('N' %1 %2) is true iff %2 == %1 + N        */
+/* (same base symbol, offsets differing by exactly N bytes).       */
+/* N must be a quoted literal, since setFromConditionArgs accepts  */
+/* only %n variables and quoted strings as arguments. Operands     */
+/* may carry a '#' immediate prefix, which is stripped. E.g. for   */
+/*   mov dptr,#_sym / movx a,@dptr / mov dptr,#(_sym + 0x0001)     */
+/* the condition operandOffset('1' %1 %2) holds, allowing the      */
+/* second load to be replaced by 'inc dptr'.                       */
+/*-----------------------------------------------------------------*/
+FBYNAME (operandOffset)
+{
+  char *op[3] = {NULL, NULL, NULL};
+  const char *addr1, *addr2;
+  char sym1[256], sym2[256];
+  int off1 = 0, off2 = 0;
+  int requestedOffset;
+  int nOps = 0;
+  int i;
+  bool match;
+
+  /* Collect the arguments. setFromConditionArgs builds its set    */
+  /* with addSetHead, i.e. LIFO: the arguments arrive here in      */
+  /* reverse of their order in the rule text. For the rule text    */
+  /* operandOffset('N' %1 %2) this yields                          */
+  /*   op[0] = %2, op[1] = %1, op[2] = N.                          */
+  {
+    set *operands = setFromConditionArgs (cmdLine, vars);
+    const void *item;
+
+    for (item = setFirstItem (operands); item && nOps < 3; item = setNextItem (operands))
+      op[nOps++] = Safe_strdup ((const char *) item);
+    deleteSet (&operands);
+  }
+
+  if (nOps < 3 || !op[0] || !op[1] || !op[2])
+    {
+      for (i = 0; i < nOps; i++)
+        Safe_free (op[i]);
+      return false;
+    }
+
+  requestedOffset = (int) strtol (op[2], NULL, 0);
+
+  /* strip # prefix from the operands if present */
+  addr1 = op[0];
+  addr2 = op[1];
+  if (*addr1 == '#')
+    addr1++;
+  if (*addr2 == '#')
+    addr2++;
+
+  /* parse both symbolic addresses */
+  if (!parseSymAddr (addr1, sym1, sizeof (sym1), &off1) ||
+      !parseSymAddr (addr2, sym2, sizeof (sym2), &off2))
+    {
+      for (i = 0; i < 3; i++)
+        Safe_free (op[i]);
+      return false;
+    }
+
+  /* check: same symbol and off1 == off2 + requestedOffset */
+  match = (!strcmp (sym1, sym2) && off1 == off2 + requestedOffset);
+
+  for (i = 0; i < 3; i++)
+    Safe_free (op[i]);
+  return match;
+}
