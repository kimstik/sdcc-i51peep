 /*-----------------------------------------------------------------*/
+/* applyRule - replaces a matched pattern at *spl and does the     */
+/* bookkeeping shared by all apply sites in peepHole               */
+/*-----------------------------------------------------------------*/
+static void
+applyRule (peepRule *pr, lineNode **pls, lineNode **spl, lineNode *mtail,
+           unsigned long *rule_application_counter, bool *restart)
+{
+  (*rule_application_counter)++;
+
+  /* replace at the head or in the middle of the list */
+  if (*spl == *pls)
+    {
+      replaceRule (pls, mtail, pr);
+      *spl = *pls;
+    }
+  else
+    replaceRule (spl, mtail, pr);
+
+  /* if restart rule type then
+     start at the top again */
+  if (pr->restart)
+    *restart = true;
+
+  /* tidy up the variable bindings of this match */
+  if (pr->vars)
+    {
+      hTabDeleteAll (pr->vars);
+      Safe_free (pr->vars);
+      pr->vars = NULL;
+    }
+
+  freeTrace (&_G.values);
+}
+
